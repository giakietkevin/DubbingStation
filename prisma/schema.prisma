datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("FREE_USER") // FREE_USER, PAID_USER, ADMIN, API_DEVELOPER
  language      String    @default("vi")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  wallet        CreditWallet?
  subscription  Subscription?
  audioProjects AudioProject[]
  customVoices  CustomVoice[]
  apiKeys       ApiKey[]
  paymentOrders PaymentOrder[]
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String    @default("Default API Key")
  keyHash     String    @unique // Mã băm hoặc key token dạng ds_live_xxxx
  maskedKey   String    // Hiển thị rút gọn ds_live_...xxxx
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CreditWallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  balance        Int           @default(50000)
  totalEarned    Int           @default(50000)
  totalConsumed  Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   CreditTransaction[]
}

model CreditTransaction {
  id           String   @id @default(cuid())
  walletId     String
  amount       Int      // Dương nếu nạp, Âm nếu tiêu thụ
  balanceAfter Int
  type         String   // FREE_ONBOARDING, SUBSCRIPTION_RENEWAL, TTS_USAGE, DUBBING_USAGE, STT_USAGE, ADMIN_ADJUSTMENT, API_USAGE
  description  String
  createdAt    DateTime @default(now())

  wallet       CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model PaymentOrder {
  id                    String    @id @default(cuid())
  userId                String
  planId                String
  billingCycle          String
  amountVnd             Int
  credits               Int
  transferContent       String    @unique
  status                String    @default("PENDING") // PENDING, PAID, EXPIRED
  providerTransactionId String?   @unique
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  tier               String    @default("FREE") // FREE, LITE, STARTER, GROWTH, PRO
  status             String    @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AudioProject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   // TTS, DUBBING, STT, WASM_TOOL, API_V1
  inputData   String?
  outputUrl   String?
  durationSec Float?
  charCount   Int?
  creditsUsed Int      @default(0)
  status      String   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomVoice {
  id          String   @id @default(cuid())
  userId      String
  name        String
  sampleUrl   String?
  modelKey    String?
  gender      String?
  language    String   @default("vi-VN")
  status      String   @default("READY")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
